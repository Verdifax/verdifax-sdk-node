# Dependencies — installed by `npm install` from package.json + package-lock.json.
# Never committed; reproducible from package-lock.json.
node_modules/

# Build output — produced by `npm run build` (tsup) during the release
# workflow. The published npm package includes dist/ via package.json's
# "files" key, but the git repo treats it as a derived artifact.
dist/

# Test / type-check intermediate files
.tsbuildinfo
*.tsbuildinfo
coverage/
.nyc_output/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS noise
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment / secrets
.env
.env.*
!.env.example
